{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "jsx": "preserve",
    "allowJs": true,
    "allowSyntheticDefaultImports" :false,
    "disableSizeLimit": false
  },
  "include": [
      "**/*.js",  // Include all JS files in the project
      "fixtures/*.js",  // Adjust for specific folders as needed
      "pageobjects/*.js",
    ],
    "exclude": ["node_modules"]
}